{
  "name": "means",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API proxy runs the Worker; every other path is served as a static asset.
    "run_worker_first": ["/api/*"],
  },
  // BACKEND_ORIGIN (the Cloud Run URL) is set in the dashboard, so a deploy must not wipe it.
  "keep_vars": true,
}
